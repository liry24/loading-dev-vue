{
  "name": "loading-dev-vue",
  "version": "0.1.0",
  "description": "Beautiful loading indicators for Vue 3.",
  "keywords": [
    "indicator",
    "loader",
    "loading",
    "spinner",
    "vue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liry24/loading-dev-vue.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/vdom/index.mjs",
  "types": "./dist/vdom/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/vdom/index.d.mts",
      "browser": "./dist/vdom/index.mjs",
      "node": "./dist/vdom/index.node.mjs",
      "import": "./dist/vdom/index.mjs"
    },
    "./vapor": {
      "types": "./dist/vapor/index.d.mts",
      "browser": "./dist/vapor/index.mjs",
      "node": "./dist/vdom/index.node.mjs",
      "import": "./dist/vapor/index.mjs"
    }
  },
  "scripts": {
    "build": "bun scripts/clean-dist.mjs && tsdown --config tsdown.config.ts && tsdown --config tsdown.vapor.config.ts",
    "check": "bun run format:check && bun run lint && bun run unused && bun run build && bun run typecheck && bun run test",
    "dev": "tsdown --watch",
    "format": "oxfmt src tests scripts tsdown.config.ts tsdown.vapor.config.ts vitest.config.mts tsconfig.json package.json .github/workflows .vscode/extensions.json --write",
    "format:check": "oxfmt src tests scripts tsdown.config.ts tsdown.vapor.config.ts vitest.config.mts tsconfig.json package.json .github/workflows .vscode/extensions.json --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "prepack": "bun run build",
    "test": "vitest run && bun tests/vapor-browser.mjs",
    "test:vue35": "bun tests/vue35-consumer.mjs",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "unused": "knip"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "jsdom": "^30.1.1",
    "knip": "^6.37.0",
    "oxfmt": "^0.69.0",
    "oxlint": "^1.84.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue": "3.6.0-rc.9",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "packageManager": "bun@1.4.2",
  "knip": {
    "entry": [
      "src/index.ts",
      "src/index.node.ts",
      "src/vapor.ts",
      "tests/**/*.test.ts",
      "tests/vapor-browser-entry.ts"
    ]
  }
}
